# ==============================================================================
# Git Ignore Rules — Yash Srivastava Developer Portfolio
# Static Production Architecture (Zero-dependency vanilla HTML5/CSS3/ES6)
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Environment & Secrets (Never commit secrets!)
.env
.env.local
.env.*.local
.env.*
*.pem
*.key
*.cert

# Archives & Compressed Backups
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Logs, Cache & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.old
*.orig
scratch/
.cache/
.parcel-cache/

# Build & Dependency Artifacts (if Node/Bundler tools are added later)
node_modules/
dist/
build/
